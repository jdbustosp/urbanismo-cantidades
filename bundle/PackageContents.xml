<?xml version="1.0" encoding="utf-8"?>
<!--
  Bundle de Autodesk Autoloader para Urbanismo Cantidades.
  DOS bloques de componentes: cada version de AutoCAD carga solo el suyo.
  - 2019-2024 (R23.0-R24.2): lsp + UrbCantRibbon2023.dll (.NET Framework 4.8)
  - 2025-2026 (R25.0-R25.1): lsp + UrbCantRibbon2025.dll (.NET 8)
  2026-08-28: Civil 3D 2026 corre sobre .NET 8 IGUAL que 2025 (verificado
  en vivo: coreclr 8.0.30 en acad.exe 2026) -- R25.0 y R25.1 son binario-
  compatibles y COMPARTEN el DLL net8. NO crear un DLL "2026" con los
  paquetes NuGet AutoCAD.NET 25.1.x/26.0.0: son net10-only (AutoCAD 2027)
  y un DLL net10 falla EN SILENCIO en 2026 (se perdio medio dia asi).
  La pestana que "no aparecia" en 2026 eran otros dos bugs, ya resueltos
  en UrbCantRibbon.cs: el cambio de workspace borraba la pestana (ahora
  hay vigilante en Idle que la repone) y el autoloader 2026 no cargaba el
  .lsp (ahora el DLL lo carga como respaldo).
  La pestana CANTIDADES la dibuja el DLL en vivo (ribbon dinamico); el
  cuix quedo como respaldo en el repo pero YA NO se instala (evita
  pestana duplicada). instalar_bundle.ps1 copia todo.
-->
<ApplicationPackage
    SchemaVersion="1.0"
    AutodeskProduct="AutoCAD"
    AppVersion="4.51.0"
    ProductType="Application"
    Name="Urbanismo Cantidades"
    Description="Cuantificacion de obras de urbanismo: andenes, vias, rampas, prefabricados, redes y movimiento de tierras. Pestana CANTIDADES."
    Author="JD Bustos"
    ProductCode="{7A3E6B10-9C44-4D2A-8F5E-URBCANT00001}">
  <CompanyDetails Name="JD Bustos" Email="jd.bustosp@hotmail.com" />
  <Components>
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R23.0" SeriesMax="R24.2" />
    <ComponentEntry
        AppName="UrbanismoCantidades"
        ModuleName="./Contents/urbanismo_cantidades.lsp"
        AppDescription="Motor AutoLISP de Urbanismo Cantidades"
        LoadOnAutoCADStartup="True" />
    <ComponentEntry
        AppName="UrbanismoCantidadesRibbon2023"
        ModuleName="./Contents/net/UrbCantRibbon2023_v4481.dll"
        AppDescription="Pestana CANTIDADES (ribbon dinamico, 2019-2024)"
        LoadOnAutoCADStartup="True" />
  </Components>
  <Components>
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R25.0" SeriesMax="R25.1" />
    <ComponentEntry
        AppName="UrbanismoCantidades25"
        ModuleName="./Contents/urbanismo_cantidades.lsp"
        AppDescription="Motor AutoLISP de Urbanismo Cantidades"
        LoadOnAutoCADStartup="True" />
    <ComponentEntry
        AppName="UrbanismoCantidadesRibbon2025"
        ModuleName="./Contents/net/UrbCantRibbon2025.dll"
        AppDescription="Pestana CANTIDADES (ribbon dinamico, 2025-2026)"
        LoadOnAutoCADStartup="True" />
  </Components>
</ApplicationPackage>



