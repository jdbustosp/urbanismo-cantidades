      <MenuMacro UID="MM_PREFAB"><Macro type="Any"><Name xlate="true">Prefabricado</Name><Command>^C^C_PREFABRICADO </Command></Macro></MenuMacro>
      <MenuMacro UID="MM_TSAN"><Macro type="Any"><Name xlate="true">Tramo sanitario</Name><Command>^C^C_TSANITARIO </Command></Macro></MenuMacro>
      <MenuMacro UID="MM_TPLU"><Macro type="Any"><Name xlate="true">Tramo pluvial</Name><Command>^C^C_TPLUVIAL </Command></Macro></MenuMacro>
