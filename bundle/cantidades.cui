      <MenuMacro UID="MM_PSAN"><Macro type="Any"><Name xlate="true">Pozo sanitario</Name><Command>^C^C_POZOSAN </Command></Macro></MenuMacro>
      <MenuMacro UID="MM_PPLU"><Macro type="Any"><Name xlate="true">Pozo pluvial</Name><Command>^C^C_POZOPLU </Command></Macro></MenuMacro>
      <MenuMacro UID="MM_SUMID"><Macro type="Any"><Name xlate="true">Sumidero</Name><Command>^C^C_SUMIDERO </Command></Macro></MenuMacro>
      <MenuMacro UID="MM_CAMARA"><Macro type="Any"><Name xlate="true">Camara electrica</Name><Command>^C^C_CAMARA </Command></Macro></MenuMacro>
      <MenuMacro UID="MM_ACCES"><Macro type="Any"><Name xlate="true">Accesorio acueducto</Name><Command>^C^C_ACCESORIO </Command></Macro></MenuMacro>
      <MenuMacro UID="MM_LUMIN"><Macro type="Any"><Name xlate="true">Luminaria</Name><Command>^C^C_LUMINARIA </Command></Macro></MenuMacro>
