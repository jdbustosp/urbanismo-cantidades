<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<CustSection SchemaVersion="4.0">
  <MenuGroup Name="CANTIDADES">
    <MacroGroup Name="CantidadesMacros" UID="MG_CANT">
      <MenuMacro UID="MM_VIA"><Macro type="Any"><Name xlate="true">Via</Name><Command>^C^C_VIA </Command></Macro></MenuMacro>
      <MenuMacro UID="MM_ANDEN"><Macro type="Any"><Name xlate="true">Anden</Name><Command>^C^C_ANDEN </Command></Macro></MenuMacro>
