      <MenuMacro UID="MM_ETAPAS"><Macro type="Any"><Name xlate="true">Etapas en lote</Name><Command>^C^C_ETAPAS </Command></Macro></MenuMacro>
      <MenuMacro UID="MM_QCUADRO"><Macro type="Any"><Name xlate="true">Cuadro de cantidades</Name><Command>^C^C_QCUADRO </Command></Macro></MenuMacro>
      <MenuMacro UID="MM_QMEM"><Macro type="Any"><Name xlate="true">Memoria de via</Name><Command>^C^C_QMEMORIA </Command></Macro></MenuMacro>
      <MenuMacro UID="MM_QVERIF"><Macro type="Any"><Name xlate="true">Tabla de verificacion</Name><Command>^C^C_QVERIFICACION </Command></Macro></MenuMacro>
      <MenuMacro UID="MM_QALC"><Macro type="Any"><Name xlate="true">Incluir o excluir</Name><Command>^C^C_QALCANCE </Command></Macro></MenuMacro>
      <MenuMacro UID="MM_QCSV"><Macro type="Any"><Name xlate="true">CSV de redes</Name><Command>^C^C_QCSV </Command></Macro></MenuMacro>
      <MenuMacro UID="MM_QEXCEL"><Macro type="Any"><Name xlate="true">Exportar Excel</Name><Command>^C^C_QEXCEL </Command></Macro></MenuMacro>
      <MenuMacro UID="MM_QVINC"><Macro type="Any"><Name xlate="true">Vincular Excel</Name><Command>^C^C_QVINCULAR </Command></Macro></MenuMacro>
