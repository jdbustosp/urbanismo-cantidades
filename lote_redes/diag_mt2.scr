(load "C:/Users/jdbus/Documents/URBANISMO/work/lote_redes/lote_redes.lsp")
(setq pf (open "C:/Users/jdbus/Documents/URBANISMO/work/lote_redes/diag_mt2.txt" "w"))
(defun dg (m) (write-line m pf))
;; A) etiquetas d= (con longitud) y B) etiquetas de banco SIN d= ("4%%C6\" PVC")
(setq etqs nil bancos nil subs nil)
(setq f (open (strcat lr:dir "data_SRC_SERIE1.txt") "r"))
(while (setq lin (read-line f))
  (if (wcmatch lin "TXT|*")
    (progn
      (setq parts (lr:split lin "|"))
      (setq txt (nth 3 parts))
      (setq p (lr:parse-pt (nth 2 parts)))
      (if (and txt p)
        (cond
          ((vl-string-search "d=" txt)
            (setq info (lr:parse-etq-mt txt))
            (if (and info (car info))
              (setq etqs (cons (list (car p) (cadr p) (car info) (cadr info)) etqs))))
          ;; banco sin d=: "...4%%C6" PVC..." (con posible "2(" de doble circuito)
          ((and (vl-string-search "%%C6" txt) (vl-string-search "PVC" (strcase txt)))
            (setq pos (vl-string-search "%%C6" txt))
            (setq nduc (atoi (substr txt pos 1)))
            (if (> pos 0) (setq nduc (atoi (substr txt (max 1 (- pos 1)) 2))))
            (setq dob (if (vl-string-search "2(3X" (strcase txt)) 2 1))
            (if (> nduc 0)
              (setq bancos (cons (list (car p) (cadr p) nduc dob txt) bancos)))))))))
(close f)
(dg (strcat "Etiquetas d=: " (itoa (length etqs)) " | bancos sin d=: " (itoa (length bancos))))
(foreach b bancos (dg (strcat "  BANCO-SIN-D: " (itoa (caddr b)) " ductos x" (itoa (nth 3 b)) " -> " (nth 4 b))))
;; posiciones de subestaciones del modelo
(setq e (entnext))
(while e
  (setq ed (entget e))
  (if (and (= (cdr (assoc 0 ed)) "INSERT")
           (wcmatch (cdr (assoc 2 ed)) "MP_PUNTO_SUBESTACION*"))
    (setq subs (cons (cdr (assoc 10 ed)) subs)))
  (setq e (entnext e)))
(dg (strcat "Subestaciones: " (itoa (length subs))))
(defun dist-nom (nb / pos)
  (setq pos (vl-string-search "MT_" nb))
  (atof (vl-string-translate "_" "." (substr nb (+ pos 4)))))
;; tramos: validacion tipo lote (etq d= mas cercana QUE CALCE en longitud +-6)
(setq e (entnext) tot 0 val 0 sum2 0.0 n2 0 hist nil acom 0)
(while e
  (setq ed (entget e))
  (if (and (= (cdr (assoc 0 ed)) "INSERT")
           (wcmatch (cdr (assoc 2 ed)) "MP_TRAMO_MT_*"))
    (progn
      (setq tot (1+ tot))
      (setq ip (cdr (assoc 10 ed)) rot (cdr (assoc 50 ed)))
      (setq distv (dist-nom (cdr (assoc 2 ed))))
      (setq mx (+ (car ip) (* (/ distv 2.0) (cos rot)))
            my (+ (cadr ip) (* (/ distv 2.0) (sin rot))))
      (setq atts nil sub (entnext e))
      (while (and sub (/= (cdr (assoc 0 (entget sub))) "SEQEND"))
        (setq sd (entget sub))
        (if (= (cdr (assoc 0 sd)) "ATTRIB")
          (setq atts (cons (cons (cdr (assoc 2 sd)) (cdr (assoc 1 sd))) atts)))
        (setq sub (entnext sub)))
      (setq a-lng (atof (if (cdr (assoc "LONGITUD" atts)) (cdr (assoc "LONGITUD" atts)) "0")))
      ;; etiqueta validada estilo lote
      (setq best nil bd 35.0)
      (foreach q etqs
        (setq d (sqrt (+ (expt (- (car q) mx) 2) (expt (- (cadr q) my) 2))))
        (if (and (< d bd) (< (abs (- (caddr q) a-lng)) 6.0))
          (setq bd d best q)))
      (if best
        (progn
          (setq val (1+ val))
          (setq dl (- a-lng (caddr best)))
          (setq sum2 (+ sum2 dl) n2 (1+ n2))
          ;; histograma de la diferencia (redondeada a 0.5)
          (setq k (rtos (* 0.5 (fix (+ 0.5 (/ dl 0.5)))) 2 1))
          (setq par (assoc k hist))
          (if par (setq hist (subst (cons k (1+ (cdr par))) par hist))
            (setq hist (cons (cons k 1) hist)))))
      ;; acometida: extremo a <=2.5 m de una subestacion
      (setq esup nil)
      (foreach s subs
        (foreach px (list ip (list (+ (car ip) (* distv (cos rot)))
                                   (+ (cadr ip) (* distv (sin rot)))))
          (setq d (sqrt (+ (expt (- (car s) (car px)) 2) (expt (- (cadr s) (cadr px)) 2))))
          (if (< d 2.5) (setq esup T))))
      (if esup
        (progn
          (setq acom (1+ acom))
          ;; banco sin d= mas cercano
          (setq bb nil bbd 25.0)
          (foreach b bancos
            (setq d (sqrt (+ (expt (- (car b) mx) 2) (expt (- (cadr b) my) 2))))
            (if (< d bbd) (setq bbd d bb b)))
          (dg (strcat "ACOM h=" (cdr (assoc 5 ed))
            " ductos-attr=" (if (cdr (assoc "DUCTOS" atts)) (cdr (assoc "DUCTOS" atts)) "?")
            " L=" (rtos a-lng 2 2)
            (if bb (strcat " | banco plano: " (itoa (caddr bb)) " ductos x"
              (itoa (nth 3 bb)) " circuitos (a " (rtos bbd 2 1) " m)")
              " | sin banco cerca")))))))
  (setq e (entnext e)))
(dg (strcat "RESUMEN: " (itoa tot) " tramos | con etiqueta d= VALIDADA: " (itoa val)
  " | dif media L-d: " (rtos (/ sum2 (max 1 n2)) 2 2) " m | acometidas a SE: " (itoa acom)))
(dg "HISTOGRAMA dif (L - d), paso 0.5 m:")
(foreach par (vl-sort hist '(lambda (a b) (< (atof (car a)) (atof (car b)))))
  (dg (strcat "  " (car par) " m -> " (itoa (cdr par)) " tramos")))
(dg "DIAG2-OK")
(close pf)
(princ)
