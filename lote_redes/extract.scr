(setq xf-name (getvar "DWGNAME"))
(setq xf-base (substr xf-name 1 (- (strlen xf-name) 4)))
(setq xf (open (strcat "C:/Users/jdbus/Documents/URBANISMO/work/lote_redes/data_" xf-base ".txt") "w"))
(defun xf-skip-layer (lay)
  (or (= lay "Defpoints")
      (wcmatch lay "CO_*,0 scm*,DIAGRAMA,IMPLANTA,AREAS VIAS,ACH*,PEDRAPLEN,DIQUE,VALLADO,ESPEJO*")))
(defun xf-num (v) (if v (rtos v 2 4) "?"))
(defun xf-pt (p) (strcat (xf-num (car p)) "," (xf-num (cadr p))))
(defun xf-clean (s / i c out)
  (setq out "" i 1)
  (repeat (strlen s)
    (setq c (substr s i 1))
    (if (or (= c "\n") (= c "\r") (= c "|")) (setq c " "))
    (setq out (strcat out c))
    (setq i (1+ i)))
  out)
(setq e (entnext))
(setq n 0)
(while e
  (setq ed (entget e))
  (setq typ (cdr (assoc 0 ed)))
  (setq lay (cdr (assoc 8 ed)))
  (if (not (xf-skip-layer lay))
    (progn
      (cond
        ((= typ "INSERT")
          (setq bn (cdr (assoc 2 ed)))
          (if (not (wcmatch bn "FORMATO*,A$*,LOTEO*,SUBETAPAS,RESIDUAL,COTAS VIA,NUMERACION*,SERIE*,PLUVIAL,ACUEDUCTO"))
            (progn
              (setq ip (cdr (assoc 10 ed)))
              (setq lin (strcat "BLK|" lay "|" bn "|" (xf-pt ip)
                "|" (xf-num (cdr (assoc 50 ed)))))
              (setq ae (entnext e))
              (setq aed (if ae (entget ae) nil))
              (while (and aed (= (cdr (assoc 0 aed)) "ATTRIB"))
                (setq lin (strcat lin "|" (cdr (assoc 2 aed)) "="
                  (xf-clean (cond ((cdr (assoc 1 aed))) ("")))))
                (setq ae (entnext ae))
                (setq aed (if ae (entget ae) nil)))
              (write-line lin xf))))
        ((= typ "LWPOLYLINE")
          (setq lin (strcat "PLW|" lay "|"))
          (foreach par ed
            (if (= (car par) 10)
              (setq lin (strcat lin (xf-pt (cdr par)) ";"))))
          (write-line lin xf))
        ((= typ "LINE")
          (write-line (strcat "LIN|" lay "|" (xf-pt (cdr (assoc 10 ed)))
            ";" (xf-pt (cdr (assoc 11 ed))) ";") xf))
        ((= typ "ARC")
          (write-line (strcat "ARC|" lay "|" (xf-pt (cdr (assoc 10 ed)))
            "|r=" (xf-num (cdr (assoc 40 ed)))
            "|a1=" (xf-num (cdr (assoc 50 ed)))
            "|a2=" (xf-num (cdr (assoc 51 ed)))) xf))
        ((= typ "POLYLINE")
          (setq lin (strcat "PL2|" lay "|"))
          (setq ve (entnext e))
          (setq ved (if ve (entget ve) nil))
          (while (and ved (= (cdr (assoc 0 ved)) "VERTEX"))
            (setq lin (strcat lin (xf-pt (cdr (assoc 10 ved))) ";"))
            (setq ve (entnext ve))
            (setq ved (if ve (entget ve) nil)))
          (write-line lin xf))
        ((= typ "MLINE")
          (setq lin (strcat "MLN|" lay "|"))
          (foreach par ed
            (if (= (car par) 11)
              (setq lin (strcat lin (xf-pt (cdr par)) ";"))))
          (write-line lin xf))
        ((or (= typ "TEXT") (= typ "MTEXT"))
          (setq txv (cond ((cdr (assoc 1 ed))) ("")))
          (write-line (strcat "TXT|" lay "|" (xf-pt (cdr (assoc 10 ed)))
            "|" (xf-clean (substr txv 1 160))) xf))
        ((= typ "MULTILEADER")
          (setq lin (strcat "MLD|" lay "|"))
          (setq mtx "")
          (foreach par ed
            (if (= (car par) 304)
              (setq mtx (strcat mtx (xf-clean (cdr par)) " ")))
            (if (= (car par) 10)
              (setq lin (strcat lin (xf-pt (cdr par)) ";"))))
          (write-line (strcat lin "|" (substr mtx 1 160)) xf))
        ((= typ "LEADER")
          (setq lin (strcat "LDR|" lay "|"))
          (foreach par ed
            (if (= (car par) 10)
              (setq lin (strcat lin (xf-pt (cdr par)) ";"))))
          (write-line lin xf))
        ((= typ "SPLINE")
          (setq lin (strcat "SPL|" lay "|"))
          (foreach par ed
            (if (= (car par) 10)
              (setq lin (strcat lin (xf-pt (cdr par)) ";"))))
          (write-line lin xf)))
      (setq n (1+ n))))
  (setq e (entnext e)))
(write-line (strcat "FIN registros-procesados=" (itoa n)) xf)
(close xf)
(princ "EXTRACT-OK")
