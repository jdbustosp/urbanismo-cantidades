(setq pf-name (getvar "DWGNAME"))
(setq pf-base (substr pf-name 1 (- (strlen pf-name) 4)))
(setq pf (open (strcat "C:/Users/jdbus/Documents/URBANISMO/work/lote_redes/probe_" pf-base ".txt") "w"))
(write-line (strcat "PROBE de " pf-name) pf)
(setq xnames nil)
(setq bl (tblnext "BLOCK" T))
(while bl
  (setq bnom (cdr (assoc 2 bl)))
  (setq bflg (cdr (assoc 70 bl)))
  (if (= 4 (logand 4 bflg))
    (progn
      (setq xnames (cons bnom xnames))
      (write-line (strcat "XREF-DEF: " bnom) pf)))
  (setq bl (tblnext "BLOCK")))
(setq cnt nil)
(setq bcnt nil)
(setq tcap nil)
(setq tlines nil)
(setq n 0)
(setq e (entnext))
(while e
  (setq ed (entget e))
  (setq typ (cdr (assoc 0 ed)))
  (setq lay (cdr (assoc 8 ed)))
  (setq key (strcat lay "|" typ))
  (setq itm (assoc key cnt))
  (if itm
    (setq cnt (subst (cons key (1+ (cdr itm))) itm cnt))
    (setq cnt (cons (cons key 1) cnt)))
  (if (= typ "INSERT")
    (progn
      (setq bn (cdr (assoc 2 ed)))
      (setq key2 (strcat lay "|" bn))
      (setq itm (assoc key2 bcnt))
      (if itm
        (setq bcnt (subst (cons key2 (1+ (cdr itm))) itm bcnt))
        (setq bcnt (cons (cons key2 1) bcnt)))
      (if (member bn xnames)
        (progn
          (setq ip (cdr (assoc 10 ed)))
          (write-line (strcat "XREF-INSERT: " bn
            " ins=" (rtos (car ip) 2 4) "," (rtos (cadr ip) 2 4)
            " rot=" (rtos (cdr (assoc 50 ed)) 2 6)
            " sx=" (rtos (cdr (assoc 41 ed)) 2 6)) pf)))))
  (if (or (= typ "TEXT") (= typ "MTEXT"))
    (progn
      (setq k (assoc lay tcap))
      (if (null k)
        (progn
          (setq tcap (cons (cons lay 0) tcap))
          (setq k (assoc lay tcap))))
      (if (< (cdr k) 14)
        (progn
          (setq tcap (subst (cons lay (1+ (cdr k))) k tcap))
          (setq txv (cdr (assoc 1 ed)))
          (if (null txv) (setq txv ""))
          (setq tlines (cons (strcat lay " :: " (substr txv 1 90)) tlines))))))
  (setq n (1+ n))
  (setq e (entnext e)))
(write-line "--- CONTEO capa|tipo = cantidad ---" pf)
(foreach par cnt (write-line (strcat (car par) " = " (itoa (cdr par))) pf))
(write-line "--- BLOQUES capa|nombre = cantidad ---" pf)
(foreach par bcnt (write-line (strcat (car par) " = " (itoa (cdr par))) pf))
(write-line "--- TEXTOS muestras por capa ---" pf)
(foreach ln (reverse tlines) (write-line ln pf))
(write-line (strcat "FIN total-entidades=" (itoa n)) pf)
(close pf)
(princ "PROBE-OK")
