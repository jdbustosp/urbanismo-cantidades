(defun lab:record (key ms / p)
 (if (setq p (assoc key lab:stats))
  (setq lab:stats (subst (list key (1+ (cadr p)) (+ ms (caddr p))) p lab:stats))
  (setq lab:stats (cons (list key 1 ms) lab:stats))))
(defun lab:engine (candidate)
 (load (strcat "C:/Users/juanbusper/Documents/URBANISMO/work/anden_three_options/" (if candidate "profile-candidate.lsp" "profile-engine.lsp")))
 (load "C:/Users/juanbusper/Documents/URBANISMO/work/anden_three_options/wrappers.lsp")
 (load "C:/Users/juanbusper/Documents/URBANISMO/work/anden_three_options/cache.lsp")
