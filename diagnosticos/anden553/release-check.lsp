(defun rc:hatches (def / item result data)
 (vlax-for item def
  (if (= (vla-get-ObjectName item) "AcDbHatch")
   (progn (setq data (vl-remove-if '(lambda (p) (member (car p) '(-1 5 330 360 102 -3))) (entget (vlax-vla-object->ename item))))
    (setq result (cons data result)))))
 (vl-sort result 'nx:less))
(defun rc:case (tag g top format side / en h block def result nested o)
 (setq en (nx:curve 80.0) h (cdr (assoc 5 (entget en))))
 (urb:set-anden-data en "Loseta" "1" "1" g top format "No" "Seleccionar en dibujo" "Via creada")
 (setq *urb-current-tactile-side-choice* nil *urb-current-tactile-side-point* side)
 (bn:check (list tag 'BUILD) (urb:build-anden-finish en "Loseta" g top format))
 (setq block (urb:package-anden en) def (vla-Item (vla-get-Blocks (urb:doc)) (vla-get-Name block)) nested 0)
 (vlax-for o def (if (= (vla-get-ObjectName o) "AcDbBlockReference") (setq nested (1+ nested))))
 (bn:check (list tag 'FLAT) (= nested 0))
 (bn:check (list tag 'NO_LOOSE) (= 0 (nx:loose h)))
 (bn:check (list tag 'ORDER) (= 0 (BNCHECKORDER (vla-get-Name block)))))
