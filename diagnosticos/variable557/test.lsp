(defun vc:log (x / f) (setq f (open (strcat vc:dir "result.txt") "a")) (write-line (vl-princ-to-string x) f) (close f))
(defun vc:check (label ok) (if (not ok) (setq vc:fail (1+ vc:fail))) (vc:log (list (if ok 'OK 'FAIL) label)))
(defun vc:poly (points / en) (setq en (urb:open-poly-from-points points 0.0)) (vla-put-Closed (vlax-ename->vla-object en) :vlax-true) en)
(defun vc:case (label source code / en obj data t0 end e count hatch area entry groups0)
 (setq obj (vla-Copy (vlax-ename->vla-object source)) en (vlax-vla-object->ename obj) data (entget en) area (vla-get-Area obj)
       entry (assoc code *urb-send-tipos*) groups0 (vla-get-Count (vla-get-Groups (urb:doc))) vc:queue (list en) t0 (getvar "MILLISECS") end (entlast))
 (urb:poly-element-draw entry "5" "5A" "Ninguno" "Ninguno" "Interno" "URB_SENDERO")
 (setq e (entnext end) count 0)
 (while e
  (if (= (cdr (assoc 0 (entget e))) "HATCH") (setq hatch (vlax-ename->vla-object e) count (1+ count)))
  (setq e (entnext e)))
 (vc:check (list label 'ONE_HATCH) (= count 1))
 (vc:check (list label 'METADATA) (= code (car (urb:get-xdata-strings en "URB_SENDERO"))))
 (vc:check (list label 'ONE_GROUP) (= (1+ groups0) (vla-get-Count (vla-get-Groups (urb:doc)))))
 (vc:check (list label 'SOURCE_GEOMETRY) (equal (vl-remove-if-not '(lambda (p) (member (car p) '(10 42 90 70))) data)
       (vl-remove-if-not '(lambda (p) (member (car p) '(10 42 90 70))) (entget en))))
 (if hatch
  (progn
   (vc:check (list label 'AREA) (equal area (vla-get-Area hatch) 1e-6))
   (vc:check (list label 'LAYER) (= (nth 6 entry) (vla-get-Layer hatch)))
   (vc:check (list label 'PATTERN) (= (if (= code "CICLORRUTA") "SOLID" "NET") (vla-get-PatternName hatch)))
   (vc:log (list label 'MS (- (getvar "MILLISECS") t0) 'AREA (rtos area 2 9) 'PER (vla-get-Length obj)))))
 en)
