 ;; Solo se sustituyen entradas interactivas; validacion y constructor son reales.
 (defun urb:draw-closed-polyline (/ en) (setq en (car vc:queue) vc:queue (cdr vc:queue)) (if (and en (urb:anden-shape-ok-p (urb:lwpoly-points-with-arcs en))) en))
 (defun urb:pick-design-cotas () nil)
 (vc:check 'REAL_VALID (urb:anden-shape-ok-p pts))
 (vc:check 'CROSS_REJECT (not (urb:anden-shape-ok-p '((0 0) (10 10) (0 10) (10 0)))))
 (vc:case 'REAL_CICLORRUTA real "CICLORRUTA")
 (vc:case 'REAL_SENDERO real "SEND-ECO")
 (setq wide (vc:poly '((0 0) (10 0) (20 -8) (30 0) (40 0) (40 2) (30 2) (20 10) (10 2) (0 2))))
 (vc:case 'VARIABLE_2_A_18M wide "SEND-TROTE")
 (setq concave (vc:poly '((100 0) (120 0) (120 20) (116 20) (116 4) (104 4) (104 20) (100 20))))
 (vc:case 'CONCAVO_U concave "SEND-ECO")
 (setq curve (entmakex '((0 . "LWPOLYLINE") (100 . "AcDbEntity") (100 . "AcDbPolyline") (90 . 6) (70 . 1)
  (10 200.0 0.0) (42 . 0.3) (10 220.0 0.0) (42 . 0.0) (10 225.0 10.0) (42 . 0.0)
  (10 215.0 20.0) (42 . -0.2) (10 205.0 10.0) (42 . 0.0) (10 200.0 3.0) (42 . 0.0))))
 (vc:case 'CURVAS_VARIABLES curve "CICLORRUTA")
 (command "_.QSAVE")
 (vc:log (list 'DONE 'FAILURES vc:fail)))
