(defun ac:log (v / f) (setq f (open "C:/Users/juanbusper/Documents/URBANISMO/work/fix507/native_result.txt" "a")) (write-line (vl-princ-to-string (list (getvar "MILLISECS") v)) f) (close f))
(defun ac:ok (name ok detail / fh sh)
  (if (wcmatch name "*_FAST_EQUALS_FULL")
    (progn
      (setq fh (mapcar 'vla-get-Handle fast) sh (mapcar 'vla-get-Handle slow))
      (setq ok (and (= (length fh) (length sh))
        (vl-every '(lambda (h) (member h sh)) fh)))))
  (if (wcmatch name "*_AREAS") (setq ok (< (abs (- actual full)) 0.000003)))
  (ac:log (list (if ok 'OK 'FAIL) name detail)))
