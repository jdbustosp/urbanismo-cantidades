(defun ac:bench (label en side expected / t0 buildms packms built blk h attrs def n item bb ib bad full fast slow savedparent total actual a g w region)
  (urb:set-anden-data en "Loseta" "1" "1" "Si" "Si" "20 x 20 cm" "No" "SUP_TN" "Via creada")
  (setq *urb-current-tactile-side-choice* nil *urb-current-tactile-side-point* side
    h (cdr (assoc 5 (entget en))) bb (urb:object-box-points (vlax-ename->vla-object en)) t0 (getvar "MILLISECS"))
  (ac:log (list label 'BUILD_START h))
  (setq built (urb:build-anden-finish en "Loseta" "Si" "Si" "20 x 20 cm") buildms (- (getvar "MILLISECS") t0))
  (ac:ok (strcat label "_BUILD") built buildms)
  (if built (progn
    (setq fast (urb:generated-objects h) savedparent *urb-generation-parent* *urb-generation-parent* nil)
    (setq slow (urb:generated-objects h) *urb-generation-parent* savedparent)
    (ac:ok (strcat label "_FAST_EQUALS_FULL")
      (equal (mapcar 'vla-get-Handle fast) (mapcar 'vla-get-Handle slow)) (list (length fast) (length slow)))
    (setq t0 (getvar "MILLISECS") blk (urb:package-anden en) packms (- (getvar "MILLISECS") t0))
    (ac:ok (strcat label "_BLOCK") (= (type blk) 'VLA-OBJECT) (list 'BUILD_MS buildms 'PACK_MS packms 'TOTAL_MS (+ buildms packms)))
    (setq attrs (urb:block-attribute-values blk) def (vla-Item (vla-get-Blocks (urb:doc)) (vla-get-Name blk)) n 0 bad 0)
    (vlax-for item def
      (setq n (1+ n))
      (if (member (vla-get-ObjectName item) '("AcDbRegion" "AcDbHatch"))
        (progn (setq ib (urb:object-box-points item))
          (if (or (< (caar ib) (- (caar bb) 0.01)) (< (cadar ib) (- (cadar bb) 0.01))
            (> (car (nth 2 ib)) (+ (car (nth 2 bb)) 0.01)) (> (cadr (nth 2 ib)) (+ (cadr (nth 2 bb)) 0.01))) (setq bad (1+ bad))))))
    (ac:ok (strcat label "_NO_OVERSIZED_FILL") (= bad 0) (list bad n))
    (setq actual (atof (mp:getval "AREA_SIN_SOBREANCHO_M2" attrs "0"))
      full (+ (atof (mp:getval "LOSETA_LISA_M2" attrs "0")) (atof (mp:getval "ADOQUIN_20X10_M2" attrs "0"))
        (atof (mp:getval "LOSETA_GUIA_M2" attrs "0")) (atof (mp:getval "LOSETA_TOPEROL_M2" attrs "0"))))
    (ac:ok (strcat label "_AREAS") (< (abs (- actual full)) 0.025) (list actual full))
    (ac:ok (strcat label "_TACTILE_LENGTH")
      (and (> (atof (mp:getval "LOSETA_GUIA_ML" attrs "0")) (* expected 0.97))
           (> (atof (mp:getval "LOSETA_TOPEROL_ML" attrs "0")) (* expected 0.97)))
      (list (mp:getval "LOSETA_GUIA_ML" attrs "0") (mp:getval "LOSETA_TOPEROL_ML" attrs "0")))
    (ac:ok (strcat label "_NO_LOOSE") (null (urb:generated-objects h)) 'FULL_SCAN)
    (ac:log (list label 'HANDLE (vla-get-Handle blk))))))
