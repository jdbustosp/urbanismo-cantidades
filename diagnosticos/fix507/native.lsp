;; S de dos arcos verdaderos con curvaturas opuestas, 80 m, ancho3.5.
(defun ac:s (/ r th d b p0 p1 p2 q0 q1 q2 dx dy)
  (setq r 80.0 th 0.5 d 1.75 b (/ (sin (/ th 4.0)) (cos (/ th 4.0))) dx 101500.0 dy 99000.0
    p0 (list dx (+ dy d)) p1 (list (+ dx (* (- r d) (sin th))) (+ dy r (- (* (- r d) (cos th)))))
    p2 (list (+ dx (* 2 r (sin th))) (+ dy (* 2 r (- 1 (cos th))) d))
    q0 (list dx (- dy d)) q1 (list (+ dx (* (+ r d) (sin th))) (+ dy r (- (* (+ r d) (cos th)))))
    q2 (list (+ dx (* 2 r (sin th))) (- (+ dy (* 2 r (- 1 (cos th)))) d)))
  (entmakex (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") '(8 . "0") '(100 . "AcDbPolyline") '(90 . 6) '(70 . 1)
    (cons 10 p0) (cons 42 b) (cons 10 p1) (cons 42 (- b)) (cons 10 p2) '(42 . 0.0)
    (cons 10 q2) (cons 42 b) (cons 10 q1) (cons 42 (- b)) (cons 10 q0) '(42 . 0.0))))
(setq ac:result (vl-catch-all-apply 'ac:bench (list "SCURVE80" (ac:s) '(101502.0 99001.5) 80.0)))
(if (vl-catch-all-error-p ac:result) (ac:log (list 'ERROR (vl-catch-all-error-message ac:result))))
